<Window x:Class="TodoWpfApp.Windows.TodoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Feladat Szerkesztése" Height="350" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="Feladat neve:"/>
            <TextBox Name="TxtName" Margin="0,5,0,10" Height="25"/>

            <CheckBox Name="ChkIsCompleted" Content="Elvégezve" Margin="0,5,0,15"/>

            <TextBlock Text="Felelős Tag:"/>
            <ComboBox Name="CmbMember" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5,0,10" Height="25"/>

            <TextBlock Text="Helyszín:"/>
            <ComboBox Name="CmbPlace" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5,0,20" Height="25"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Mentés" Width="80" Height="30" Margin="0,0,10,0" Click="Save_Click" IsDefault="True"/>
                <Button Content="Mégse" Width="80" Height="30" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>