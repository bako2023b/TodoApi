<Window x:Class="TodoWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoWpfApp"
        mc:Ignorable="d"
        Title="Feladatkezelő" Height="600" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigációs Menü -->
        <Border Background="#2C3E50" Grid.Column="0">
            <StackPanel Margin="10">
                <TextBlock Text="Feladatkezelő" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,10,0,30" HorizontalAlignment="Center"/>
                <Button Name="BtnTodos" Content="Feladatok" Height="40" Margin="0,5" Click="Navigate_Click" Tag="Todos"/>
                <Button Name="BtnMembers" Content="Tagok" Height="40" Margin="0,5" Click="Navigate_Click" Tag="Members"/>
                <Button Name="BtnPlaces" Content="Helyszínek" Height="40" Margin="0,5" Click="Navigate_Click" Tag="Places"/>
            </StackPanel>
        </Border>

        <!-- Aktuális Nézet Helye -->
        <ContentControl Name="MainContent" Grid.Column="1" Margin="15"/>
    </Grid>
</Window>
